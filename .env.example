# copy to .env and fill in your values
# cp .env.example .env

# needed for gated HuggingFace models (medgemma requires auth)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# vLLM judge server URLs (one process per GPU, launched by run_all.sh or the notebook)
LOCAL_VLLM_JUDGE1_URL=http://localhost:8001   # medgemma
LOCAL_VLLM_JUDGE2_URL=http://localhost:8002   # biomistral
LOCAL_VLLM_JUDGE3_URL=http://localhost:8003   # meditron
LOCAL_VLLM_JUDGE4_URL=http://localhost:8004   # medalpaca

# vLLM doesn't actually check this but some clients require a non-empty value
LOCAL_API_KEY=local-no-key-needed
