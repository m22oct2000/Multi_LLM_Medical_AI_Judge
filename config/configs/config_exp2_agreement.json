{
  "experiment": "exp2_agreement_analysis",
  "description": "Run all four locally-deployed SLM judges on the 100-question benchmark under five rubrics (PEMAT, HealthBench, ClinicalEval, Prometheus, PEMAT-Likert). Classify panel agreement per question across five clinical domains. Matches paper Table 1 (Exp1) and Table 2 (Exp2).",
  "judges": [
    {
      "id": "medgemma",
      "model": "google/medgemma-4b-it",
      "url": "http://localhost:8001"
    },
    {
      "id": "biomistral",
      "model": "BioMistral/BioMistral-7B-DARE",
      "url": "http://localhost:8002"
    },
    {
      "id": "meditron",
      "model": "epfl-llm/meditron-7b",
      "url": "http://localhost:8003"
    },
    {
      "id": "medalpaca",
      "model": "medalpaca/medalpaca-7b",
      "url": "http://localhost:8004"
    }
  ],
  "rubrics": [
    "rubrics/rubric1_pemat.json",
    "rubrics/rubric2_healthbench.json",
    "rubrics/rubric3_clinical_eval.json",
    "rubrics/rubric4_prometheus.json",
    "rubrics/rubric5_pemat_likert.json"
  ],
  "benchmark_csv": "benchmark_dataset/agreement_benchmark.csv",
  "domains": [
    "Cardiology",
    "Pharmacology",
    "Neurology",
    "Pediatrics",
    "Emergency"
  ],
  "agreement_thresholds": {
    "FA": 0.95,
    "MA": 0.75,
    "SP": 0.50
  },
  "temperature": 0.0,
  "max_tokens": 1024,
  "timeout_seconds": 120,
  "print_rationales": true,
  "output_files": {
    "results_json": "results/exp2_agreement_results.json",
    "figure_dir": "results/figures"
  }
}
