{
  "experiment": "exp4_boxplot_agreement",
  "description": "Box-plot visualisation of Agr distributions across rubrics and domains. Reads Exp2 output JSON -- no LLM calls required.",
  "input_results_json": "results/exp2_agreement_results.json",
  "judges": [
    { "id": "medgemma",  "model": "google/medgemma-4b-it",           "url": "http://localhost:8001" },
    { "id": "biomistral","model": "BioMistral/BioMistral-7B-DARE",  "url": "http://localhost:8002" },
    { "id": "meditron",  "model": "epfl-llm/meditron-7b",            "url": "http://localhost:8003" },
    { "id": "medalpaca", "model": "medalpaca/medalpaca-7b",           "url": "http://localhost:8004" }
  ],
  "rubrics": [
    "rubrics/rubric1_pemat.json",
    "rubrics/rubric2_healthbench.json",
    "rubrics/rubric3_clinical_eval.json",
    "rubrics/rubric4_prometheus.json",
    "rubrics/rubric5_pemat_likert.json"
  ],
  "agreement_thresholds": { "FA": 0.95, "MA": 0.75, "SP": 0.50 },
  "output_files": {
    "figure_dir": "results/figures"
  }
}
